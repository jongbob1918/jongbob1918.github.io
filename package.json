{
  "name": "jongbob1918-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --root site",
    "deploy": "bash scripts/deploy.sh",
    "build:projects": "node scripts/build-projects.mjs",
    "build:notes": "astro build --root site",
    "build": "npm run build:projects && npm run build:notes && mkdir -p dist/projects dist/assets && cp index.html styles.css script.js projects.json dist/ && cp -R projects/. dist/projects/ && cp -R assets/. dist/assets/",
    "preview": "astro preview --root site"
  },
  "devDependencies": {
    "astro": "^7.2.0"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.47",
    "marked": "^18.0.9",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-math": "^6.0.0"
  }
}
