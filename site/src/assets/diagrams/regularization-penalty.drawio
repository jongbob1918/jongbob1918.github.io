<?xml version="1.0" encoding="utf-8"?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="regularization-penalty" name="규제항 만들기">
    <mxGraphModel dx="1100" dy="480" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="480" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;규제항 만들기&lt;/b&gt; · L1 규제 예시" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=none;strokeColor=none;fontColor=#1E293B;fontFamily=Helvetica;fontSize=20;spacing=10;align=left;fontSize=28;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="25" width="1020" height="50" />
        </mxCell>
        <mxCell id="weights" value="가중치&lt;br&gt;&lt;br&gt;&lt;b&gt;−2, 1, −3&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#1E293B;fontFamily=Helvetica;fontSize=20;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="220" width="210" height="130" />
        </mxCell>
        <mxCell id="sum" value="가중치 크기의 합&lt;br&gt;&lt;br&gt;&lt;b&gt;|−2| + |1| + |−3| = 6&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E293B;fontFamily=Helvetica;fontSize=20;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="300" y="220" width="290" height="130" />
        </mxCell>
        <mxCell id="lambda" value="사람이 정하는 규제 강도&lt;br&gt;&lt;b&gt;λ = 0.1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF7ED;strokeColor=#FDBA74;fontColor=#1E293B;fontFamily=Helvetica;fontSize=20;spacing=10;fontSize=18;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="595" y="100" width="240" height="80" />
        </mxCell>
        <mxCell id="multiply" value="×" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#1E293B;fontFamily=Helvetica;fontSize=20;spacing=10;ellipse;shape=ellipse;fontSize=36;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="680" y="250" width="70" height="70" />
        </mxCell>
        <mxCell id="penalty" value="규제항 (패널티)&lt;br&gt;&lt;br&gt;&lt;b&gt;0.1 × 6 = 0.6&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ECFDF5;strokeColor=#6EE7B7;fontColor=#1E293B;fontFamily=Helvetica;fontSize=20;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="840" y="220" width="220" height="130" />
        </mxCell>
        <mxCell id="a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="weights" target="sum">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="sum" target="multiply">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="c" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="lambda" target="multiply">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="d" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="multiply" target="penalty">
