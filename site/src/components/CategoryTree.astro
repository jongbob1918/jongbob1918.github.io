---
import { getCollection } from 'astro:content';
import { buildFolders } from '../data/folders';
import FolderBranch from './FolderBranch.astro';
interface Props {
  activeFolder?: string;
}
const { activeFolder } = Astro.props;
const notes = await getCollection('notes', ({ data }) => !data.draft);
const folders = buildFolders(notes);
---

<nav class="sidebar-nav" aria-label="글 폴더">
  <a class:list={['all-notes-link', { active: !activeFolder }]} href="/notes/">
    <span>분류 전체보기</span><small>({notes.length})</small>
  </a>
  <div class="category-tree">
    {folders.map(folder => <FolderBranch folder={folder} activeFolder={activeFolder} />)}
  </div>
</nav>
