---
import { folderUrl, type NoteFolder } from '../data/folders';
interface Props {
  folder: NoteFolder;
  activeFolder?: string;
}
const { folder, activeFolder } = Astro.props;
const active = activeFolder === folder.path;
const expanded = active || activeFolder?.startsWith(`${folder.path}/`);
const preview = folder.notes.slice(0, 5);
const currentPath = decodeURIComponent(Astro.url.pathname);
---

<details class="category-folder" open={expanded}>
  <summary>
    <strong>{folder.title}</strong>
    <small>({folder.count})</small>
  </summary>
  <div class="category-children">
    {folder.children.map(child => <Astro.self folder={child} activeFolder={activeFolder} />)}
    {preview.map(note => {
      const href = `/notes/${note.id}/`;
      const current = currentPath === decodeURIComponent(href);
      return (
        <a class:list={['folder-note', { active: current }]} href={href} aria-current={current ? 'page' : undefined} title={note.data.title}>
          <span>{note.data.title}</span>
        </a>
      );
    })}
    <a class="folder-more" href={folderUrl(folder.path)} aria-current={active && currentPath === decodeURIComponent(folderUrl(folder.path)) ? 'page' : undefined}>
      <span>더보기</span><small>전체 {folder.count}개 →</small>
    </a>
  </div>
</details>
