<div class="listing-controls">
  <div class="view-toggle" role="group" aria-label="글 보기 방식">
    <button type="button" data-note-view="cards" aria-label="카드 보기" title="카드 보기" aria-pressed="false" aria-controls="notes-grid"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1 1h5v5H1zM10 1h5v5h-5zM1 10h5v5H1zM10 10h5v5h-5z" /></svg></button>
    <button type="button" data-note-view="list" aria-label="리스트 보기" title="리스트 보기" aria-pressed="true" aria-controls="notes-grid"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1 1h14v2H1zM1 5h14v2H1zM1 9h14v2H1zM1 13h14v2H1z" /></svg></button>
  </div>
</div>

<script>
  const grid = document.querySelector<HTMLElement>('#notes-grid');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-note-view]')];
  const applyView = (value: string | null) => {
    const view = value === 'cards' ? 'cards' : 'list';
    if (grid) grid.dataset.view = view;
    buttons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.noteView === view)));
  };
  try { applyView(localStorage.getItem('notes-view')); } catch { applyView('list'); }
  buttons.forEach(button => button.addEventListener('click', () => {
    const view = button.dataset.noteView ?? 'cards';
    applyView(view);
    try { localStorage.setItem('notes-view', view); } catch { /* Viewing works without storage. */ }
  }));
</script>
