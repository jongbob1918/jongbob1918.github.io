---
import type { CollectionEntry } from 'astro:content';
import { marked } from 'marked';
import { noteFolder, folderTitle } from '../data/folders';

interface Props { note: CollectionEntry<'notes'>; }
const { note } = Astro.props;
const folder = noteFolder(note);
const label = folderTitle(folder);
const body = note.body ?? '';
const imageTag = body.match(/<img\b[^>]*\bsrc="([^"]+)"[^>]*>/i);
const markdownImage = body.match(/!\[([^\]]*)\]\(([^\s)]+)\)/);
const thumbnail = imageTag?.[1] ?? markdownImage?.[2];
const plainText = (text: string) => text
  .replace(/\$\$[\s\S]*?\$\$|\$[^$\n]+\$/g, '')
  .replace(/!?\[([^\]]*)\]\([^)]*\)/g, '$1')
  .replace(/<[^>]*>/g, '').replace(/[*_`]/g, '').replace(/\s+/g, ' ').trim();
const excerpt = note.data.description || marked.lexer(body)
  .filter(token => token.type === 'paragraph')
  .map(token => plainText((token as { text: string }).text))
  .filter(Boolean).slice(0, 3).join(' ').slice(0, 320);
const formatDate = (date: Date) => new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric', month: '2-digit', day: '2-digit'
}).format(date);
const searchText = `${note.data.title} ${note.data.description} ${folder} ${note.data.tags.join(' ')}`;
---
<article class="note-card search-item" data-search={searchText}>
  <a class="card-cover" href={`/notes/${note.id}/`} tabindex="-1" aria-hidden="true">
    {thumbnail ? <img src={thumbnail} alt="" loading="lazy" /> : <span class="cover-placeholder">{label}</span>}
  </a>
  <div class="card-body">
    <h2><a href={`/notes/${note.id}/`} title={note.data.title}>{note.data.title}</a></h2>
    {excerpt && <p class="card-excerpt">{excerpt}</p>}
    <div class="card-meta">
      <time datetime={note.data.publishedAt.toISOString()}>{formatDate(note.data.publishedAt)}</time>
      <span>{label}</span>
    </div>
  </div>
</article>
