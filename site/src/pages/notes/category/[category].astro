---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NotesSidebar from '../../../components/NotesSidebar.astro';
import NoteCard from '../../../components/NoteCard.astro';
import { categories, categoryMap } from '../../../data/taxonomy';

export function getStaticPaths() {
  return categories.map(category => ({ params: { category: category.id } }));
}

const category = categoryMap.get(Astro.params.category ?? '');
if (!category) return Astro.redirect('/notes/');

const notes = (await getCollection('notes', ({ data }) => !data.draft && data.category === category.id))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout title={`${category.title} — Robotics Notes`} description={category.description}>
  <div class="notes-page-shell">
    <NotesSidebar activeCategory={category.id} />
    <main class="notes-listing">
      <header class="listing-header category-listing-header">
        <div>
          <p>{category.number} · Category</p>
          <h1>{category.title}</h1>
          <span class="listing-description">{category.description}</span>
        </div>
        <span>{notes.length}개의 글</span>
      </header>
      <div class="topic-chips" aria-label="주요 주제">
        {category.topics.map(topic => <span>{topic}</span>)}
      </div>
      {notes.length ? (
        <div class="note-card-grid">
          {notes.map(note => <NoteCard note={note} />)}
        </div>
      ) : (
        <div class="empty-category">
          <strong>아직 공개된 글이 없습니다.</strong>
          <p>이 분야의 글이 추가되면 이곳에 카드로 표시됩니다.</p>
        </div>
      )}
    </main>
  </div>
</BaseLayout>
