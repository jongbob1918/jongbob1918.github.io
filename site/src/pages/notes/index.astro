---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NotesSidebar from '../../components/NotesSidebar.astro';
import ListingControls from '../../components/ListingControls.astro';
import NoteCard from '../../components/NoteCard.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout title="Robotics Notes — Jongmyung Kim" description="로봇공학 기술 노트와 프로젝트에서 검증한 구현 기록">
  <div class="notes-page-shell">
    <NotesSidebar />
    <main class="notes-listing">
      <header class="listing-header">
        <div>
          <h1>전체 글 <span class="listing-count">({notes.length})</span></h1>
        </div>
        <ListingControls />
      </header>
      <div class="note-card-grid" id="notes-grid" data-view="list">
        {notes.map(note => <NoteCard note={note} />)}
      </div>
      <p class="search-empty" hidden>검색 결과가 없습니다.</p>
    </main>
  </div>

  <script>
    const inputs = [...document.querySelectorAll<HTMLInputElement>('.sidebar-search input')];
    const cards = [...document.querySelectorAll<HTMLElement>('.note-card')];
    const empty = document.querySelector<HTMLElement>('.search-empty');
    const initialQuery = new URLSearchParams(window.location.search).get('q') ?? '';

    const filterCards = (query: string) => {
      let visible = 0;
      cards.forEach(card => {
        const matches = !query || (card.dataset.search ?? '').toLocaleLowerCase('ko').includes(query.toLocaleLowerCase('ko'));
        card.hidden = !matches;
        if (matches) visible += 1;
      });
      if (empty) empty.hidden = visible > 0;
    };

    inputs.forEach(input => {
      input.value = initialQuery;
      input.addEventListener('input', () => {
        inputs.forEach(other => { if (other !== input) other.value = input.value; });
        filterCards(input.value.trim());
      });
    });
    filterCards(initialQuery);

  </script>
</BaseLayout>
